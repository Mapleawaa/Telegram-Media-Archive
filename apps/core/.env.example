# Telegram（必填）
TG_BOT_TOKEN=123456:ABC-your-bot-token
TG_ARCHIVE_CHAT_ID=-100xxxxxxxxxx
# 国内网络需经代理访问 api.telegram.org（如 Clash/Mihomo 默认端口）
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890

# Core
CORE_HOST=127.0.0.1
CORE_PORT=8787
LOG_LEVEL=info
# TMA_DATA_DIR=

# AI（M3 起使用；各能力模型独立可配，留空则跳过该能力）
# AI_PROVIDER：auto（默认，baseUrl+key+chatModel 齐全时启用）/ none / mock / openai
# AI_PROVIDER=auto
# AI_BASE_URL=https://api.siliconflow.cn/v1
# AI_API_KEY=
# AI_CHAT_MODEL=            # 文本富化 / Agent
# AI_VLM_MODEL=             # 缩略图视觉理解（留空 = 不做视觉步骤）
# AI_EMBED_MODEL=           # M4 向量检索用
