# AI（M3 起使用；三个能力各自独立配置——像编程工具给不同角色配不同模型）
#
# 总开关：auto（默认，任一能力配齐 baseUrl+key+model 即启用）/ none / mock（离线演示）/ openai
# AI_PROVIDER=auto
#
# 文本能力（摘要、标签、Agent）
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=
# AI_CHAT_MODEL=deepseek-flash
#
# 视觉能力（缩略图理解；留空 = 跳过视觉步骤）
# AI_VLM_MODEL=deepseek-v4-flash-vision-exp
#
# 向量能力（RAG 检索；留空 = 语义检索降级为 FTS）
# 常用 OpenAI 兼容端点：
#   DeepSeek        无 embedding
#   硅基流动        https://api.siliconflow.cn/v1      模型 BAAI/bge-m3（中文佳）
#   智谱            https://open.bigmodel.cn/api/paas/v4  模型 embedding-3
#   本地 Ollama     http://127.0.0.1:11434/v1          模型 bge-m3（免费离线，需先 ollama pull bge-m3）
# AI_EMBED_MODEL=
#
# 任一能力可用独立的 BASE_URL / API_KEY 指向不同服务商（缺省回退到上面的共享 AI_BASE_URL / AI_API_KEY）
# AI_CHAT_BASE_URL=  AI_CHAT_API_KEY=
# AI_VLM_BASE_URL=   AI_VLM_API_KEY=
# AI_EMBED_BASE_URL=http://127.0.0.1:11434/v1   AI_EMBED_API_KEY=ollama
#
# 向量扩展开关（sqlite-vec；默认开启，加载失败时自动降级）
# VEC_ENABLED=true